FROM chaoxidao-frontend:20261026-island-life-v1 AS builder
USER root
COPY frontend/ /app/
ENV REVIEW_MODE=true NEXT_PUBLIC_API_BASE_URL=/api NEXT_TELEMETRY_DISABLED=1
RUN npm ci --include=dev && npm run build -- --webpack && npm prune --omit=dev

FROM chaoxidao-frontend:20261026-island-life-v1
USER root
RUN rm -rf /app/.next /app/node_modules
COPY --from=builder --chown=node:node /app/.next /app/.next
COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --chown=node:node frontend/ /app/
USER node
